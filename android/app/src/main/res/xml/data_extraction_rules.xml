<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Device credentials and pins are deliberately excluded from backup. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
